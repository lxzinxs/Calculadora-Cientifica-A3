{
  "name": "calculadora-a3",
  "version": "1.0.0",
  "description": "Uma calculadora científica web de alto desempenho desenvolvida com uma estética **Cyberpunk Neon / Dark Tech**, estruturada em múltiplos módulos de computação avançada e suporte completo a **Modo Escuro (Dark) e Modo Claro (Light)**.",
  "scripts": {
    "build": "node scripts/build-assets.cjs && tailwindcss -i assets/input.css -o assets/utilities.css --minify",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "serve": "python3 -m http.server 8000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtvpc/Calculadora-Cientifica-A3.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vtvpc/Calculadora-Cientifica-A3/issues"
  },
  "homepage": "https://github.com/vtvpc/Calculadora-Cientifica-A3#readme",
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "mathjs": "^15.2.0"
  },
  "private": true
}
